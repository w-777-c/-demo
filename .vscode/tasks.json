{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "打包 Windows EXE",
            "type": "shell",
            "command": "${workspaceFolder}\\package-exe.bat",
            "args": [
                "${input:ironArenaVersion}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "ironArenaVersion",
            "type": "promptString",
            "description": "EXE version (for example 1.2.0)",
            "default": "1.2.0"
        }
    ]
}
